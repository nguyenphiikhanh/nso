{
  "name": "game-asset-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env.local server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "node --env-file-if-exists=.env.local server/index.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.5",
    "vue": "^3.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1"
  }
}
