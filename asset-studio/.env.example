# ========================================================
# NSO Game Asset Studio - Environment Variables Template
# Sao chép file này thành .env.local để sử dụng cho máy local:
# cp .env.example .env.local
# ========================================================

# Cổng chạy API Backend của Studio (Mặc định: 3001)
PORT=3001

# Cấu hình kết nối MariaDB / MySQL game NSO
ASSET_STUDIO_DB_HOST=127.0.0.1
ASSET_STUDIO_DB_PORT=3306
ASSET_STUDIO_DB_NAME=nsoshare
ASSET_STUDIO_DB_USER=root
ASSET_STUDIO_DB_PASSWORD=NsoRoot2026

# Đặt = 1 nếu chạy Node.js trong Docker container cùng compose network
ASSET_STUDIO_IN_DOCKER=0

# Đường dẫn thư mục dữ liệu game (mặc định lấy theo cấu trúc repo NSO_FINAL)
# GAME_DATA_MAP_DIR=../Data/Map
# GAME_SOURCE_IMG_DIR=../Data/Img
# GAME_PROJECT_DIR=./projects/default
